
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "sonnet",

  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },

  "theme": "dark",

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "permissions": {
    "defaultMode": "default",

    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit --message *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",

      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)"
    ],

    "ask": [
      "Bash(git add -A)",
      "Bash(git add --all)",
      "Bash(git add .)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git tag *)",
      "Bash(terraform apply *)"
    ],

    "deny": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git clean *)",
      "Bash(git commit --amend *)"
    ]
  }
}
